PORT=3000
NODE_ENV=development

# Domínios permitidos (inclui 'null' para permitir testes com front-end aberto via arquivo local file://)
ALLOWED_ORIGINS=http://localhost:8080
ALLOW_NULL_ORIGIN=true

# Limites por IP a cada 15 minutos
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_UPLOAD_MAX=15
RATE_LIMIT_DOWNLOAD_MAX=40
