# ==========================================
# Configurações do Servidor
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Domínios Permitidos (CORS & WebSocket)
# ==========================================
# Informe os domínios permitidos separados por vírgula (sem barra ao final).
# Em produção, adicione a URL do seu site front-end:
# ALLOWED_ORIGINS=https://meu-site.com,https://app.meu-site.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# Se definido como 'true' em produção, rejeita requisições diretas de ferramentas (cURL/Postman) que não enviarem Origin
REQUIRE_ORIGIN=false

# ==========================================
# Limites de Taxa (Rate Limiting) por IP
# ==========================================
# Máximo de requisições gerais à API por IP a cada 15 minutos
RATE_LIMIT_GLOBAL_MAX=200

# Máximo de uploads de vídeo por IP a cada 15 minutos (proteção de CPU e disco)
RATE_LIMIT_UPLOAD_MAX=15

# Máximo de downloads de vídeos convertidos por IP a cada 15 minutos
RATE_LIMIT_DOWNLOAD_MAX=40

